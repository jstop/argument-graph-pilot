# Copy to infra/services.env and fill in. Read by infra/compose.services.yaml.
# services.env is git-ignored. Never commit it.

# Cloud mode only: traefik routes issuer.<domain> and <RP_SUBDOMAIN>.<domain>.
PUBLIC_DOMAIN=example.com
RP_SUBDOMAIN=claims

# Where phones and KERIA reach the issuer (it serves the schema there).
#   local: http://arglog-issuer:3110          (docker network name; phones cannot use this)
#   cloud: https://issuer.<PUBLIC_DOMAIN>
ISSUER_PUBLIC_URL=http://arglog-issuer:3110
ISSUER_DISPLAY_NAME=Community Issuer
# KERIA as a PHONE reaches it. Shown as the wallet onboarding QR on the
# operator page; the issuer also answers GET /connect with the connect URL.
#   cloud: https://keria-boot.<PUBLIC_DOMAIN> and https://keria.<PUBLIC_DOMAIN>
WALLET_BOOT_URL=http://127.0.0.1:3903
WALLET_CONNECT_URL=http://127.0.0.1:3901
# Password for the operator page (user "operator"). 16+ characters. No default:
# the issuer refuses to start without it.
OPERATOR_TOKEN=

# Relying party (the log).
COMMUNITY_NAME=Pilot community
RP_DISPLAY_NAME=Argument Log
# Where phones' KERIA agents reach the relying party (it serves the schema there).
#   local: http://arglog-log:3120    cloud: https://<RP_SUBDOMAIN>.<PUBLIC_DOMAIN>
RP_PUBLIC_URL=http://arglog-log:3120
SCHEMA_SAID=EKKBYCMIW65PqoodeRGOWqCo33SpXihGDLs1hy6SDSXe
# Filled by services.sh after the issuer's first start (or by hand from GET /api/issuer).
TRUSTED_ISSUER_AID=
TRUSTED_ISSUER_OOBI=
