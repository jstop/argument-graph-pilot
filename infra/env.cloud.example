# Copy to infra/env.cloud and fill in PUBLIC_DOMAIN and ACME_ADMIN_EMAIL.
# Mirrors Veridian's .env.production.traefik with our pins. Used by
# MODE=cloud ./stack.sh up. Needs DNS A records for:
#   keria, keria-ext, keria-boot, witness-0 .. witness-5, issuer, claims
# all pointing at this box, and ports 80/443 open (Let's Encrypt).

DEPLOYMENT_MODE=cloud
PUBLIC_DOMAIN=example.com
ACME_ADMIN_EMAIL=acme@example.com
KERIA_CURLS_PROTO=https
BASE_HTTP_PORT=5642

# KERI witnesses only. Never "cardano" (non-goal; stack.sh refuses it).
WITNESS_TYPE=keri
WITNESS_COUNT=6

# Images pinned by digest (what Veridian's ":main" resolved to on 2026-09-17).
KERIA_IMAGE=ghcr.io/veridian-id/veridian-wallet/keria@sha256:3fd30f4ddac685442378a415430228d60e0d4bd7a1e84c5554a865a06312081e
WITNESS_IMAGE=weboftrust/keri@sha256:0d0de26dda9a7a67e11bbb1d5a9c7577c1618d8efd97f96200e7e131dfd43d67

# KERIA behind traefik. The wallet is given the *boot* and *admin* URLs;
# OOBIs and witness traffic use the *ext* one.
KERIA_HOST=keria.${PUBLIC_DOMAIN}
KERIA_EXT_HOST=keria-ext.${PUBLIC_DOMAIN}
KERIA_BOOT_HOST=keria-boot.${PUBLIC_DOMAIN}
KERIA_CURLS=https://${KERIA_EXT_HOST}
# KERIA_PASSCODE is generated by stack.sh into secrets.env (git-ignored).
# KERIA_IURLS is generated by stack.sh after witness-init.
