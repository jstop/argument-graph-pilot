# Local (single machine, plain HTTP) settings for Veridian's compose stack.
# Used for development and the automated tests. A phone cannot use this
# mode: witness and KERIA URLs are docker-internal hostnames.
# For a real deployment see env.cloud.example and RUNBOOK.md.

DEPLOYMENT_MODE=local
PUBLIC_DOMAIN=localhost
KERIA_CURLS_PROTO=http
BASE_HTTP_PORT=5642

# KERI witnesses only. Never set this to "cardano": that selects
# Veridian's Cardano backer compose file, which is a non-goal here.
WITNESS_TYPE=keri
WITNESS_COUNT=6

# Images pinned by digest. Veridian's compose defaults to the moving
# ":main" tag; these are what ":main" resolved to on 2026-09-17.
KERIA_IMAGE=ghcr.io/veridian-id/veridian-wallet/keria@sha256:3fd30f4ddac685442378a415430228d60e0d4bd7a1e84c5554a865a06312081e
WITNESS_IMAGE=weboftrust/keri@sha256:0d0de26dda9a7a67e11bbb1d5a9c7577c1618d8efd97f96200e7e131dfd43d67

# KERIA_PASSCODE is generated by stack.sh into secrets.env (git-ignored).
KERIA_CURLS=http://keria:3902
# KERIA_IURLS (witness OOBIs) is generated by stack.sh after witness-init.
